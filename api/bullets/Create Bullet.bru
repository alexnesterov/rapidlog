meta {
  name: Create Bullet
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/bullets
  body: json
  auth: none
}

body:json {
  {
    "type": "task",
    "content": "Оплатить хостинг"
  }
}

example {
  name: success
  
  request: {
    url: {{baseUrl}}/api/bullets
    method: POST
    mode: json
    body:json: {
      {
        "type": "task",
        "content": "Оплатить хостинг"
      }
    }
  }
  
  response: {
    headers: {
      content-type: application/json
      date: Wed, 26 Aug 2026 13:48:49 GMT
      content-length: 224
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": "a2592511-d4ab-409b-9535-1b2c2d194132",
            "type": "task",
            "signifier": "open",
            "content": "Оплатить хостинг",
            "created_at": "2026-08-26T13:48:49.572337881Z",
            "updated_at": "2026-08-26T13:48:49.572337881Z"
          }
        }
      '''
    }
  }
}

example {
  name: invalid request body
  
  request: {
    url: {{baseUrl}}/api/bullets
    method: POST
    mode: json
    body:json: {
      не json
    }
  }
  
  response: {
    headers: {
      content-type: application/json
      date: Tue, 28 Jul 2026 12:34:33 GMT
      content-length: 68
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "data": null,
          "error": {
            "code": 400,
            "message": "invalid request body"
          }
        }
      '''
    }
  }
}

example {
  name: validation error
  
  request: {
    url: {{baseUrl}}/api/bullets
    method: POST
    mode: json
    body:json: {
      {
        "content": ""
      }
    }
  }
  
  response: {
    headers: {
      content-type: application/json
      date: Tue, 28 Jul 2026 12:35:56 GMT
      content-length: 65
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "data": null,
          "error": {
            "code": 400,
            "message": "content is required"
          }
        }
      '''
    }
  }
}
