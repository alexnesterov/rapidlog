meta {
  name: Create Bullet
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/bullets
  body: json
  auth: none
}

body:json {
  {
    "title": "Оплатить хостинг"
  }
}

example {
  name: success
  
  request: {
    url: {{baseUrl}}/api/bullets
    method: POST
    mode: json
    body:json: {
      {
        "title": "Оплатить хостинг"
      }
    }
  }
  
  response: {
    headers: {
      content-type: application/json
      date: Tue, 28 Jul 2026 12:32:49 GMT
      content-length: 209
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": "3432dcdd-2fb0-403b-8d83-7b5f1cfced94",
            "title": "Оплатить хостинг",
            "status": "OPEN",
            "created_at": "2026-07-28T15:32:49.607087+03:00",
            "updated_at": "2026-07-28T15:32:49.607087+03:00"
          }
        }
      '''
    }
  }
}

example {
  name: invalid request body
  
  request: {
    url: {{baseUrl}}/api/bullets
    method: POST
    mode: json
    body:json: {
      не json
    }
  }
  
  response: {
    headers: {
      content-type: application/json
      date: Tue, 28 Jul 2026 12:34:33 GMT
      content-length: 68
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "data": null,
          "error": {
            "code": 400,
            "message": "invalid request body"
          }
        }
      '''
    }
  }
}

example {
  name: validation error
  
  request: {
    url: {{baseUrl}}/api/bullets
    method: POST
    mode: json
    body:json: {
      {
        "title": ""
      }
    }
  }
  
  response: {
    headers: {
      content-type: application/json
      date: Tue, 28 Jul 2026 12:35:56 GMT
      content-length: 65
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "data": null,
          "error": {
            "code": 400,
            "message": "title is required"
          }
        }
      '''
    }
  }
}
