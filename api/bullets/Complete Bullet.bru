meta {
  name: Complete Bullet
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/bullets/:id/complete
  body: none
  auth: none
}

params:path {
  id:
}

example {
  name: success

  request: {
    url: {{baseUrl}}/api/bullets/77ab62e3-c6f6-4c66-8a11-309c82abc350/complete
    method: POST
    mode: none
  }

  response: {
    headers: {
      content-type: application/json
      date: Mon, 03 Aug 2026 11:56:12 GMT
      content-length: 233
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "id": "77ab62e3-c6f6-4c66-8a11-309c82abc350",
            "type": "task",
            "signifier": "completed",
            "content": "Оплатить хостинг",
            "created_at": "2026-08-03T14:56:03.385707+03:00",
            "updated_at": "2026-08-03T14:56:12.566688+03:00"
          }
        }
      '''
    }
  }
}

example {
  name: not found

  request: {
    url: {{baseUrl}}/api/bullets/00000000-0000-0000-0000-000000000000/complete
    method: POST
    mode: none
  }

  response: {
    headers: {
      content-type: application/json
      date: Mon, 03 Aug 2026 11:56:12 GMT
      content-length: 64
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: json
      content: '''
        {
          "data": null,
          "error": {
            "code": 404,
            "message": "bullet not found"
          }
        }
      '''
    }
  }
}

example {
  name: invalid id

  request: {
    url: {{baseUrl}}/api/bullets/not-a-uuid/complete
    method: POST
    mode: none
  }

  response: {
    headers: {
      content-type: application/json
      date: Mon, 03 Aug 2026 11:56:12 GMT
      content-length: 62
    }

    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "data": null,
          "error": {
            "code": 400,
            "message": "parse id error"
          }
        }
      '''
    }
  }
}
