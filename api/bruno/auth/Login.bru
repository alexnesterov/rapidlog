meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/.ory/self-service/login?flow={{loginFlowId}}
  body: json
  auth: none
}

params:query {
  flow: {{loginFlowId}}
}

body:json {
  {
    "method": "password",
    "identifier": "{{email}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  const flow = await bru.sendRequest({
    method: "GET",
    url: `${bru.getEnvVar("baseUrl")}/.ory/self-service/login/api`,
  });
  bru.setVar("loginFlowId", flow.data.id);
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("sessionToken", res.body.session_token);
  }
}

docs {
  Создаёт API login-flow и входит по email / password из окружения.
  session_token из ответа сохраняется в sessionToken.
}
