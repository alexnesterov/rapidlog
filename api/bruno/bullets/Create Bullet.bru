meta {
  name: Create Bullet
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/bullets
  body: json
  auth: none
}

body:json {
  {
    "kind": "KIND_TASK",
    "content": "Оплатить хостинг"
  }
}

example {
  name: success

  request: {
    url: {{baseUrl}}/api/bullets
    method: POST
    mode: json
    body:json: {
